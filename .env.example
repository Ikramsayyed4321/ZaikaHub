# Zaika Hub Environment Variables

# Core Application
NODE_ENV=production
PORT=3001
API_PORT=3001

# Security
JWT_SECRET=your_strong_jwt_secret_here
JWT_REFRESH_SECRET=your_strong_refresh_secret_here
BCRYPT_ROUNDS=12
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Database - SET PROPER PRODUCTION VALUES
DATABASE_URL=your_production_database_url_here
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=restaurant_db
DB_SSL=true

# Client Configuration
CLIENT_ORIGIN=https://your-production-domain.com

# Production Settings
SERVE_STATIC_FRONTEND=true
TRUST_PROXY=true

# Admin Seed (Enable for production)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=your_strong_16_plus_char_password
CONFIRM_PRODUCTION_SEED=false