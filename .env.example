###############################################
# Zaika Hub — Root Environment Template
# This file is loaded by BOTH the backend (dotenv)
# and the frontend build (Vite) when you run the
# app from the repository root. Copy to `.env`
# and fill in real values. Values shown are the
# safe local-development defaults.
###############################################

###############################################
# REQUIRED (Production)
# Change before deployment
###############################################

# Runtime mode. "production" enables security
# hardening, disables demo seed data, and turns
# on TLS/DATABASE defaults.
# Dev value:  development
# Prod value: production
# Change? YES in production. Leave as development locally.
NODE_ENV=development

# Public URL(s) of the frontend, comma-separated.
# Used by CORS to allow the browser to call the API.
# Dev value:  http://localhost:5174
# Prod value: https://your-app.onrender.com  (or your Netlify URL)
# Change? YES in production.
CLIENT_ORIGIN=http://localhost:5174

# Full MySQL/TiDB connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DB_NAME
# For TiDB Cloud Serverless use port 4000 and set DB_SSL=true.
# Dev value:  (leave blank; falls back to DB_HOST/DB_*)
# Prod value: mysql://app_user:secret@xxx.tidbcloud.com:4000/restaurant_db
# Change? YES in production.
DATABASE_URL=

# JWT signing secret for access tokens.
# Generate:  openssl rand -base64 48
# Dev value:  change-this-access-secret
# Prod value: a long random secret (>= 32 chars)
# Change? YES in production. NEVER reuse the dev value.
JWT_SECRET=change-this-access-secret

# JWT signing secret for refresh tokens (must differ
# from JWT_SECRET).
# Generate:  openssl rand -base64 48
# Dev value:  change-this-refresh-secret
# Prod value: a different long random secret
# Change? YES in production.
JWT_REFRESH_SECRET=change-this-refresh-secret

# Database password. Required when using DB_HOST/DB_USER.
# Dev value:  your_local_mysql_password
# Prod value: your TiDB/MySQL password
# Change? YES in production.
DB_PASSWORD=

###############################################
# OPTIONAL
# You normally do NOT need to change these.
###############################################

# TCP port the API binds to. Render injects PORT
# automatically; API_PORT is the local fallback.
# Dev value:  3001
# Prod value: (Render sets PORT; leave blank)
# Change? NO unless you run locally on another port.
PORT=
API_PORT=3001

# Individual database connection parts. Only used if
# DATABASE_URL is not provided.
# Dev value:  localhost / 3306 / root / restaurant_db
# Prod value: (use DATABASE_URL instead)
# Change? NO if using DATABASE_URL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=restaurant_db

# Enable TLS for the database connection (required by
# TiDB Cloud and most managed MySQL).
# Dev value:  false
# Prod value: true
# Change? Set true for any cloud DB.
DB_SSL=false

# Verify the database server certificate chain.
# Keep true for TiDB Cloud / managed MySQL (publicly
# trusted CAs). Set false ONLY if your provider uses
# a private/unbundled CA and you see a
# "self-signed certificate" handshake error.
# Dev value:  true
# Prod value: true (or false for a private-CA provider)
# Change? Usually NO.
DB_SSL_VERIFY=true

# Trust the upstream proxy (Render/Nginx) for correct
# client IP and secure cookies.
# Dev value:  false
# Prod value: true
# Change? Set true behind a reverse proxy.
TRUST_PROXY=false

# Serve the built Vite frontend from Express.
# true  = single Render Web Service (API + SPA)
# false = backend only; deploy frontend to Netlify
# Dev value:  false
# Prod value: true (single service) or false (split)
# Change? Choose based on your architecture.
SERVE_STATIC_FRONTEND=false

# JWT lifetimes.
# Change? NO unless you want different expiry.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# bcrypt cost factor. Higher = slower logins, safer.
# Change? NO unless you have CPU headroom concerns.
BCRYPT_ROUNDS=12

# Restaurant branding printed on invoices/reports.
# Change? Optional.
RESTAURANT_NAME=Zaika Hub
RESTAURANT_ADDRESS=123 Food Street, Food City
RESTAURANT_GST=GSTIN000000000

# Frontend API base path. "/api" means "same origin"
# (used when Express serves the SPA). Set the full
# Render URL when the frontend is hosted separately.
# Dev value:  /api
# Prod value: /api  (single service) OR
#             https://api.onrender.com/api (split)
# Change? YES for a split Netlify + Render setup.
VITE_API_URL=/api

###############################################
# LOCAL DEVELOPMENT ONLY
# Never rely on these in production.
###############################################

# Demo admin seeded only when NODE_ENV != production.
# Dev value:  admin@zaikahub.local / admin123
# Change? NO — ignored outside development.
SEED_ADMIN_EMAIL=admin@zaikahub.local
SEED_ADMIN_PASSWORD=admin123

###############################################
# PRODUCTION ONLY
# Used solely by `npm run seed:prod`.
###############################################

# Must be exactly "true" to allow the production
# seed script to run (safety switch).
# Change? Set true only when seeding prod admin.
CONFIRM_PRODUCTION_SEED=false

# Admin credentials created/updated by seed:prod.
# Password must be >= 16 characters.
# Change? YES when running seed:prod.
PROD_SEED_ADMIN_EMAIL=
PROD_SEED_ADMIN_PASSWORD=
