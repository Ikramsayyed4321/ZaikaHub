###############################################
# Zaika Hub — Backend Environment Template
# Copy to backend/.env (or rely on the root .env).
# The backend loads root/.env first, then this file.
###############################################

###############################################
# REQUIRED
# Change before deployment
###############################################

# Runtime mode. "production" enables security
# hardening and disables demo seed data.
# Dev value:  development
# Prod value: production
# Change? YES in production.
NODE_ENV=development

# JWT access-token signing secret (>= 32 random chars).
# Generate: openssl rand -base64 48
# Dev value:  change-this-access-secret
# Prod value: a long random secret
# Change? YES in production.
JWT_SECRET=change-this-access-secret

###############################################
# REQUIRED
# Change this before production
###############################################

# JWT refresh-token signing secret (must differ
# from JWT_SECRET).
# Generate: openssl rand -base64 48
# Dev value:  change-this-refresh-secret
# Prod value: a different long random secret
# Change? YES in production.
JWT_REFRESH_SECRET=change-this-refresh-secret

###############################################
# REQUIRED
# Replace with your TiDB or MySQL connection string
###############################################

# Full connection string.
# Format: mysql://USER:PASS@HOST:PORT/DB_NAME
# TiDB Cloud Serverless uses port 4000.
# Dev value:  (blank; falls back to DB_HOST/DB_*)
# Prod value: mysql://user:pass@host.tidbcloud.com:4000/restaurant_db
# Change? YES in production.
DATABASE_URL=

###############################################
# REQUIRED
# Replace with your database password
###############################################

# Database password (used with DB_HOST/DB_USER).
# Dev value:  your_local_password
# Prod value: your TiDB/MySQL password
# Change? YES in production.
DB_PASSWORD=

###############################################
# REQUIRED
# Replace with your frontend URL after deployment
###############################################

# Comma-separated list of allowed browser origins
# (CORS). For a single Render service use its URL.
# Dev value:  http://localhost:5174
# Prod value: https://your-app.onrender.com
# Change? YES in production.
CLIENT_ORIGIN=http://localhost:5174

###############################################
# OPTIONAL
# No need to change unless required
###############################################

# TCP port. Render injects PORT automatically.
# API_PORT is the local fallback.
# Dev value:  3001
# Prod value: (leave blank; Render sets PORT)
# Change? NO unless running locally on another port.
PORT=
API_PORT=3001

# Individual DB connection parts (only if
# DATABASE_URL is not set).
# Dev value:  localhost / 3306 / root / restaurant_db
# Prod value: (prefer DATABASE_URL)
# Change? NO if using DATABASE_URL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_NAME=restaurant_db

# Enable TLS (required by TiDB Cloud).
# Dev value:  false
# Prod value: true
# Change? Set true for any cloud DB.
DB_SSL=false

# Verify the DB server certificate chain. Keep true
# for TiDB Cloud (public CA). Set false ONLY if your
# provider uses a private CA and you hit a
# "self-signed certificate" handshake error.
# Dev value:  true
# Prod value: true (or false for a private-CA provider)
# Change? Usually NO.
DB_SSL_VERIFY=true

# Trust reverse proxy for correct client IP.
# Dev value:  false
# Prod value: true
# Change? Set true behind Render/Nginx.
TRUST_PROXY=false

# Serve the built Vite SPA from Express.
# true = single service; false = backend only.
# Dev value:  false
# Prod value: true (single) or false (split)
# Change? Choose per architecture.
SERVE_STATIC_FRONTEND=false

# JWT lifetimes and password cost.
# Change? NO unless you need different values.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Invoice/restaurant branding.
# Change? Optional.
RESTAURANT_NAME=Zaika Hub
RESTAURANT_ADDRESS=123 Food Street, Food City
RESTAURANT_GST=GSTIN000000000

###############################################
# LOCAL DEVELOPMENT ONLY
# Ignored when NODE_ENV=production
###############################################

# Demo admin user seeded in development only.
# Dev value:  admin@zaikahub.local / admin123
# Change? NO — never used in production.
SEED_ADMIN_EMAIL=admin@zaikahub.local
SEED_ADMIN_PASSWORD=admin123

###############################################
# PRODUCTION ONLY
# Used solely by `npm run seed:prod`
###############################################

# Safety switch — must be exactly "true".
# Change? Set true only when running seed:prod.
CONFIRM_PRODUCTION_SEED=false

# Production admin credentials (password >= 16 chars).
# Change? YES when running seed:prod.
PROD_SEED_ADMIN_EMAIL=
PROD_SEED_ADMIN_PASSWORD=
