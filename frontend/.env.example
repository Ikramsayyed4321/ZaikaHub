###############################################
# Zaika Hub — Frontend (Vite) Environment Template
# Copy to frontend/.env OR set VITE_API_URL in the
# root .env. Vite reads env files at build time.
###############################################

###############################################
# OPTIONAL
# No need to change for a single-service deploy
###############################################

# Base URL the browser uses to reach the API.
# "/api"  = same origin (Express serves the SPA).
# Full URL = used when the frontend is hosted
# separately (e.g. Netlify) and the API runs on
# Render. Must start with VITE_ to be exposed.
# Dev value:  /api
# Prod value: /api  (single service) OR
#             https://api.onrender.com/api (split)
# Change? YES only for a split Netlify + Render setup.
VITE_API_URL=/api
